# Application Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (PostgreSQL with pgvector for production; SQLite support for local rapid dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedsnap?schema=public

# Authentication & JWT
JWT_SECRET=super_secret_wedding_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# S3 / Cloudflare R2 Storage (Zero-egress object storage)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=wedsnap-photos
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key

# Redis & Background Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# AI Microservice (Python ONNX RetinaFace + ArcFace)
AI_SERVICE_URL=http://localhost:8000
