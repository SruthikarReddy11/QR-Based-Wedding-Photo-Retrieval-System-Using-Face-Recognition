# ==========================================
# WedSnap Production Environment Variables
# ==========================================

# Base URL of your deployed application
APP_URL=https://yourweddingdomain.com

# Node API Port & Secret
PORT=5000
NODE_ENV=production
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Python AI Service Location (internal Docker network or external URL)
AI_SERVICE_URL=http://ai-service:8000

# Frontend API URL (Used during Vite build if building separately on Vercel/Netlify)
VITE_API_URL=https://yourweddingdomain.com/api/v1

# Optional Object Storage (AWS S3 / Cloudflare R2)
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=wedsnap-photos
# S3_REGION=auto
